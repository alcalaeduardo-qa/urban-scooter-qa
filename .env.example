# ── Servidor ──────────────────────────────────────────────────────────────────
SERVER_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api/v1

# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ── Túnel SSH (dejar vacío si acceso directo a DB) ────────────────────────────
SSH_HOST=
SSH_PORT=4554
SSH_USER=
SSH_KEY_PATH=

# ── Navegador ─────────────────────────────────────────────────────────────────
OPERA_EXECUTABLE_PATH=
HEADLESS=false
SLOW_MO=0
BROWSER_TIMEOUT=15000

# ── Appium / Android ──────────────────────────────────────────────────────────
APPIUM_SERVER=http://127.0.0.1:4723
ANDROID_VERSION=13
DEVICE_NAME=emulator-5554
APP_PACKAGE=
APP_ACTIVITY=
APK_PATH=
APPIUM_IMPLICIT_WAIT=10

# ── Credenciales móvil (cuenta de prueba en la app) ───────────────────────────
MOBILE_LOGIN=
MOBILE_PASSWORD=

# ── Jira (para exportar bugs vía REST API) ────────────────────────────────────
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER=your-email@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
